# Run: .venv/Scripts/python.exe scripts/init_local_env.py
# Or supply JWT_SECRET_KEY in your deployment environment.
# An empty value deliberately fails validation. Never commit a real key here.
JWT_SECRET_KEY=
# Optional: exact frontend origins, no trailing slashes. Defaults shown below.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional existing absolute storage directory; omit to keep backend/ storage.
# CAREER_DATA_DIR=/var/lib/ai-career-assistant
